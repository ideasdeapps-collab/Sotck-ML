# === API de ML (backend FastAPI) ===
POLYGON_API_KEY=tu_api_key_de_polygon
ALLOWED_ORIGINS=https://tu-app.vercel.app,http://localhost:3000

# === Polygon: rate-limit + caché ===
# Plan Starter: llamadas ilimitadas, datos con 15 min de retraso.
# (Con el free tier, sube TTL_INTRADAY a 900 y deja POLYGON_MAX_CALLS_PER_MIN=5.)
# OJO: nunca pongas 0 aquí — api/polygon_client.py lo usa como divisor.
POLYGON_MAX_CALLS_PER_MIN=300   # Starter (ilimitado); usa 5 con el free tier
TTL_INTRADAY=15                 # caché intradía (s); usa 900 con el free tier
TTL_DAILY=3600                  # caché diario (s) = 1 h

# === Frontend (Next.js / Vercel) ===
NEXT_PUBLIC_ML_API_URL=https://tu-api-ml.onrender.com

# === (Opcional) Supabase para cachear predicciones y artefactos ===
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
